```
# Android build artifacts
*.apk
*.aar
*.dex

# Android cache
.cache/
.gradle/
build/

# IDE files
.idea/
*.iml
*.ipr
*.iws

# Log files
*.log

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Android studio Native Development Kit (NDK) files
**/src/main/cpp/**
**/src/main/jni/**

# Android arch ABIs
lib/
jni/

# Generated files
gen/
out/

# Android Studio profiler
*.hprof

# Debug and Release folders
debug/
release/

# APK Analyzer temporary files
.apk-analyzer/

# Firebase local configuration
google-services.json

# Android device state
*.avd/

# Keystore files
*.keystore
*.jks

# Generated Java files
R.java
BuildConfig.java

# Android lint
lint-results-*.xml

# Gradle daemon
.gradle/

# Local gradle settings
gradle-app.setting

# Android emulator
*.qcow2

# Android backup
*.backup

# Android bundle
*.aab

# Android native libraries
**/*.so

# Android resources
**/build/generated/**
```